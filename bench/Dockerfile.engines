# The single-node engines (Polars and DataFusion in Rust, DuckDB in C++) with their Python bindings,
# in the same kind of container as Spark. PyIceberg plans Iceberg scans for Polars and DataFusion.
FROM python:3.12-slim
RUN pip install --no-cache-dir polars==2.1.0 datafusion==55.0.0 duckdb==2.0.1 pyarrow==26.0.1 pyiceberg==0.12.0
# Bake DuckDB's iceberg extension into the image so benchmark runs do not download anything.
RUN python -c "import duckdb; duckdb.connect().execute('INSTALL iceberg')"
WORKDIR /w
